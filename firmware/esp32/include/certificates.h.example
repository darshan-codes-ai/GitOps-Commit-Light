// ============================================================================
// 2. ESP32 Device Certificate (xxxx-certificate.pem.crt)
// Replace with the certificate issued by AWS IoT Core for this device.
// ============================================================================
static const char AWS_CERT_CRT[] PROGMEM = R"KEY(
-----BEGIN CERTIFICATE-----
...REPLACE WITH YOUR ESP32 DEVICE CERTIFICATE (xxxx-certificate.pem.crt)...
-----END CERTIFICATE-----
)KEY";

// ============================================================================
// 3. ESP32 Device Private Key (xxxx-private.pem.key)
// Replace with the private key corresponding to the device certificate.
// ============================================================================
static const char AWS_CERT_PRIVATE[] PROGMEM = R"KEY(
-----BEGIN RSA PRIVATE KEY-----
...REPLACE WITH YOUR ESP32 DEVICE PRIVATE KEY (xxxx-private.pem.key)...
-----END RSA PRIVATE KEY-----
)KEY";
