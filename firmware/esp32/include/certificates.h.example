#pragma once
#include <pgmspace.h>

/**
 * ============================================================================
 * GitOps Commit Light — ESP32 X.509 Certificates Template
 * ============================================================================
 *
 * INSTRUCTIONS:
 * 1. Copy this file to 'certificates.h' in the same directory:
 *      cp include/certificates.h.example include/certificates.h
 * 2. Paste your Amazon Root CA 1, ESP32 device certificate, and ESP32 private key.
 * 3. Never commit 'certificates.h' to Git. It is excluded by .gitignore.
 *
 * AWS IoT Core requires mutual TLS (mTLS) on port 8883.
 * Storing keys in flash via PROGMEM conserves ESP32 SRAM.
 */

